local UIS = game:GetService("UserInputService")
local RS = game:GetService("RunService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local flyOn = false
local flySpeed = 60
local flyConn = nil

if game:GetService("CoreGui"):FindFirstChild("FLY_UI") then game:GetService("CoreGui").FLY_UI:Destroy() end
pcall(function() if gethui and gethui():FindFirstChild("FLY_UI") then gethui().FLY_UI:Destroy() end end)

local gui = Instance.new("ScreenGui")
gui.Name = "FLY_UI"
gui.ResetOnSpawn = false
gui.Parent = game:GetService("CoreGui")
pcall(function() if gethui then gui.Parent = gethui() end end)

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0, 80, 0, 30)
btn.Position = UDim2.new(0, 20, 0, 20) 
btn.BackgroundColor3 = Color3.new(0, 0, 0)
btn.BackgroundTransparency = 0.1
btn.Text = "FLY OFF"
btn.TextColor3 = Color3.new(1, 1, 1)
btn.TextSize = 10
btn.Font = Enum.Font.GothamBold
btn.AutoButtonColor = false
btn.Parent = gui
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

local box = Instance.new("TextBox")
box.Size = UDim2.new(0, 60, 0, 30)
box.Position = UDim2.new(0, 105, 0, 20)
box.BackgroundColor3 = Color3.new(0, 0, 0)
box.BackgroundTransparency = 0.1
box.Text = "60"
box.TextColor3 = Color3.new(1, 1, 1)
box.TextSize = 10
box.Font = Enum.Font.GothamBold
box.Parent = gui
Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)

local function toggleFly()
    if flyOn then
        flyOn = false
        btn.Text = "FLY OFF"
        btn.BackgroundColor3 = Color3.new(0, 0, 0)
        if flyConn then flyConn:Disconnect() flyConn = nil end
    else
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end

        flyOn = true
        btn.Text = "FLY ON"
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)

        flyConn = RS.RenderStepped:Connect(function()
            if not flyOn then return end
            local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if not root or not h or h.Health <= 0 then
                return
            end

            local cam = workspace.CurrentCamera
            local camCF = cam.CFrame
            local fwd = camCF.LookVector
            local right = camCF.RightVector

            local finalDir = Vector3.zero
            local md = h.MoveDirection
            if md.Magnitude > 0.01 then
                local f = md:Dot(fwd)
                local r = md:Dot(right)
                finalDir = fwd * f + right * r
            end

            local kx, kz = 0, 0
            if UIS:IsKeyDown(Enum.KeyCode.W) then kz = kz + 1 end
            if UIS:IsKeyDown(Enum.KeyCode.S) then kz = kz - 1 end
            if UIS:IsKeyDown(Enum.KeyCode.A) then kx = kx - 1 end
            if UIS:IsKeyDown(Enum.KeyCode.D) then kx = kx + 1 end
            if kx ~= 0 or kz ~= 0 then
                finalDir = finalDir + fwd * kz + right * kx
            end

            local up = 0
            if UIS:IsKeyDown(Enum.KeyCode.Space) then up = up + 1 end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then up = up - 1 end
            finalDir = finalDir + Vector3.new(0, up, 0)

            h:ChangeState(Enum.HumanoidStateType.Jumping)

            if finalDir.Magnitude > 0.01 then
                root.Velocity = finalDir.Unit * flySpeed
            else
                root.Velocity = Vector3.zero
            end
        end)
    end
end

local function makeDrag(obj)
    local drag, start, pos, dragTime
    obj.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true; start = i.Position; pos = obj.Position; dragTime = tick()
        end
    end)
    obj.InputChanged:Connect(function(i)
        if drag then
            local d = i.Position - start
            obj.Position = UDim2.new(pos.X.Scale, pos.X.Offset + d.X, pos.Y.Scale, pos.Y.Offset + d.Y)
        end
    end)
    obj.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = false
            if obj == btn and tick() - dragTime < 0.2 then
                toggleFly()
            end
        end
    end)
end
makeDrag(btn)
makeDrag(box)

box.FocusLost:Connect(function()
    local num = tonumber(box.Text)
    if num and num > 0 then
        flySpeed = math.clamp(math.floor(num), 1, 1000)
    end
    box.Text = tostring(flySpeed)
end)
