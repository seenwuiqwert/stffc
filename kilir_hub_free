local function makeDraggable(guiObject, dragHandle)
    local dragging = false
    local startOffset
    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            local pos = UIS:GetMouseLocation()
            startOffset = Vector2.new(pos.X, pos.Y) - Vector2.new(guiObject.AbsolutePosition.X, guiObject.AbsolutePosition.Y)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local pos = UIS:GetMouseLocation()
            local targetX = pos.X - startOffset.X
            local targetY = pos.Y - startOffset.Y
            guiObject.Position = UDim2.new(0, targetX, 0, targetY)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end
makeDraggable(LoginFrame, DragBarLogin)

