        else
            hum.MaxHealth = 100
            hum.Health = 100
        end
    end
end

-- ================= 创建 UI 按钮并绑定逻辑 =================
local function createToggle(name, toggleCallback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.85, 0, 0, 44)
    btn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Text = name
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 14
    btn.Parent = ScrollingFrame

    btn.MouseButton1Click:Connect(function()
        states[name:gsub(" ", "")] = not states[name:gsub(" ", "")] -- 删除空格方便作为键名
        local isOn = states[name:gsub(" ", "")]
        
        btn.BackgroundColor3 = isOn and Color3.fromRGB(40, 120, 255) or Color3.fromRGB(80, 80, 80)
        
        -- 执行回调
        if toggleCallback then
            toggleCallback(isOn)
        end
    end)
    return btn
end

