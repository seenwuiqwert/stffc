-- ================= 核心功能状态与连接 =================
local states = {
    ESP = false,
    Speed = false,
    Jump = false,
    Noclip = false,
    Climb = false,
    NightVision = false,
    KillAura = false,
    GodMode = false
}

local connections = {}
local espHighlights = {}
local originalLighting = {}

-- 1. 玩家 ESP
local function toggleESP(enable)
    if enable then
        connections.ESP = RunService.Heartbeat:Connect(function()
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    if not espHighlights[plr] or not espHighlights[plr].Parent then
                        local hl = Instance.new("Highlight")
                        hl.Adornee = plr.Character
                        hl.FillTransparency = 1
                        hl.OutlineColor = Color3.fromRGB(255, 0, 0)
                        hl.OutlineTransparency = 0
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = plr.Character
                        espHighlights[plr] = hl
                    end
                end
            end
        end)
    else
        if connections.ESP then connections.ESP:Disconnect() end
        for plr, hl in pairs(espHighlights) do
            if hl then hl:Destroy() end
        end
        espHighlights = {}
    end
end

-- 2. 修改速度
local function toggleSpeed(enable)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.WalkSpeed = enable and 100 or 16 end
end

-- 3. 修改跳跃高度
local function toggleJump(enable)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        if enable then
            hum.UseJumpPower = true
            hum.JumpPower = 100
        else
            hum.JumpPower = 50
        end
    end
end

-- 4. 穿墙
local function toggleNoclip(enable)
    if enable then
        connections.Noclip = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)
    else
        if connections.Noclip then connections.Noclip:Disconnect() end
    end
end

-- 5. 爬墙 (实现原理：穿墙 + 往前移动时获得向上推力)
local function toggleClimb(enable)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    if enable then
        local bv = Instance.new("BodyVelocity")
        bv.Name = "ClimbVelocity"
        bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
        
        connections.Climb = RunService.RenderStepped:Connect(function()
            local c = LocalPlayer.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if r and h and bv then
                local moveDir = h.MoveDirection
                if moveDir.Magnitude > 0 then
                    -- 当你在移动时，将部分向前的推力转化为向上的推力，实现爬墙效果
                    bv.Velocity = moveDir * 10 + Vector3.new(0, 50, 0)
                else
                    bv.Velocity = Vector3.zero
                end
            end
        end)
    else
        if connections.Climb then connections.Climb:Disconnect() end
        local bv = hrp:FindFirstChild("ClimbVelocity")
        if bv then bv:Destroy() end
    end
end

-- 6. 夜视
local function toggleNightVision(enable)
    if enable then
        originalLighting.Ambient = Lighting.Ambient
        originalLighting.OutdoorAmbient = Lighting.OutdoorAmbient
        originalLighting.Brightness = Lighting.Brightness
        originalLighting.ClockTime = Lighting.ClockTime
        
        Lighting.Ambient = Color3.fromRGB(200, 200, 200)
        Lighting.OutdoorAmbient = Color3.fromRGB(200, 200, 200)
        Lighting.Brightness = 3
        Lighting.ClockTime = 12
    else
        if originalLighting.Ambient then
            Lighting.Ambient = originalLighting.Ambient
            Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
            Lighting.Brightness = originalLighting.Brightness
            Lighting.ClockTime = originalLighting.ClockTime
        end
    end
end

-- 7. 杀戮光环 (5格范围内每秒扣20血)
local function toggleKillAura(enable)
    if enable then
        connections.KillAura = task.spawn(function()
            while states.KillAura do
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer and plr.Character then
                            local targetHrp = plr.Character:FindFirstChild("HumanoidRootPart")
                            local targetHum = plr.Character:FindFirstChildOfClass("Humanoid")
                            if targetHrp and targetHum and targetHum.Health > 0 then
                                local dist = (hrp.Position - targetHrp.Position).Magnitude
                                if dist <= 5 then
                                    targetHum.Health = targetHum.Health - 20
                                end
                            end
                        end
                    end
                end
                task.wait(1) -- 每秒执行一次
            end
        end)
    else
        if connections.KillAura then
            task.cancel(connections.KillAura)
        end
    end
end

